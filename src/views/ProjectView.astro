---
import { render } from 'astro:content';
import DownloadList from '../components/DownloadList.astro';
import FallbackNotice from '../components/FallbackNotice.astro';
import FeedItem from '../components/FeedItem.astro';
import TextList from '../components/TextList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeed, getProjects, getTextos } from '../lib/collections';
import { seriesFor } from '../lib/content';
import { contentLangAttr, sectionPath, type Lang } from '../lib/i18n';
import { projectTitleMap } from '../lib/lookups';
import { t } from '../lib/ui-strings';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const [projects, textos, feed] = await Promise.all([getProjects(lang), getTextos(lang), getFeed(lang)]);
const project = projects.find((p) => p.slug === slug);
if (!project) throw new Error(`Projeto "${slug}" não encontrado.`);

const data = project.entry.data;
const { Content } = await render(project.entry);
const series = seriesFor(textos, slug);
const writtenIn = contentLangAttr(lang, project.lang);
const posts = feed.filter((post) => post.entry.data.projeto === slug);
const titles = projectTitleMap(projects);
---

<BaseLayout
  lang={lang}
  title={`${data.titulo} · João Gabriel`}
  description={data.resumo}
  path={sectionPath(lang, 'projects', slug)}
  ogImage={data.capa?.src}
>
  <article style={`--project-color: ${data.cor}`}>
    <header class="head">
      <div class="container head-inner">
        <a class="crumb" href={sectionPath(lang, 'projects')}>← {t(lang, 'projectsTitle')}</a>
        <p class="eyebrow">
          {data.periodo}
          {data.tipo === 'nao-codigo' && <> · {t(lang, 'nonCode')}</>}
        </p>
        <h1 lang={writtenIn}>{data.titulo}</h1>
        <p class="summary" lang={writtenIn}>{data.resumo}</p>
        {
          data.stack.length > 0 && (
            <ul class="stack">
              {data.stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        }
        {
          (data.repo || data.links.length > 0) && (
            <p class="links">
              {data.repo && <a href={data.repo}>{t(lang, 'repository')} ↗</a>}
              {data.links.map((link) => (
                <a href={link.url}>{link.rotulo} ↗</a>
              ))}
            </p>
          )
        }
      </div>
    </header>

    <div class="container content">
      <FallbackNotice lang={lang} contentLang={project.lang} />

      {
        data.downloads.length > 0 && (
          <section aria-labelledby="dl-title" class="section">
            <h2 id="dl-title">{t(lang, 'downloadsTitle')}</h2>
            <DownloadList lang={lang} downloads={data.downloads} />
          </section>
        )
      }

      <div class="prose" lang={writtenIn}>
        <Content />
      </div>

      {
        series.length > 0 && (
          <section aria-labelledby="series-title" class="section">
            <h2 id="series-title">{t(lang, 'seriesTitle')}</h2>
            <TextList lang={lang} items={series} numbered />
          </section>
        )
      }

      {
        posts.length > 0 && (
          <section aria-labelledby="posts-title" class="section">
            <h2 id="posts-title">{t(lang, 'projectFeed')}</h2>
            <div class="posts">
              {posts.map((post) => <FeedItem lang={lang} post={post} projectTitles={titles} />)}
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-top: var(--space-5);
    color: #fff;
  }

  /* Banner arredondado na cor do projeto, com a mesma textura de pontinhos dos cartões. */
  .head-inner {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
    border-radius: var(--radius-xl);
    background-color: var(--project-color);
    background-image:
      radial-gradient(rgb(255 255 255 / 22%) 1.4px, transparent 1.6px),
      linear-gradient(135deg, var(--project-color), color-mix(in srgb, var(--project-color) 70%, #15161a));
    background-size:
      14px 14px,
      100% 100%;
    box-shadow: var(--shadow-photo);
  }

  .head a {
    color: #fff;
  }

  .crumb {
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    opacity: 0.85;
  }

  .crumb:hover {
    opacity: 1;
  }

  .head .eyebrow {
    color: rgb(255 255 255 / 85%);
  }

  h1 {
    font-size: var(--text-hero);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .summary {
    font-size: var(--text-lg);
    max-width: 44rem;
    color: rgb(255 255 255 / 92%);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
  }

  .stack li {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.25em 0.7em;
    border-radius: 999px;
    background: rgb(255 255 255 / 16%);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-weight: 600;
  }

  .content {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-6);
  }

  .section {
    display: grid;
    gap: var(--space-4);
  }

  .section h2 {
    font-size: var(--text-xl);
  }

  .posts {
    display: grid;
    gap: var(--space-4);
  }
</style>
