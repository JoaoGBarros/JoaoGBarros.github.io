---
import { render } from 'astro:content';
import FallbackNotice from '../components/FallbackNotice.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, getTextos } from '../lib/collections';
import { seriesFor, seriesNeighbors } from '../lib/content';
import { contentLangAttr, formatDate, sectionPath, type Lang } from '../lib/i18n';
import { t } from '../lib/ui-strings';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const [projects, textos] = await Promise.all([getProjects(lang), getTextos(lang)]);
const texto = textos.find((x) => x.slug === slug);
if (!texto) throw new Error(`Texto "${slug}" não encontrado.`);

const data = texto.entry.data;
const { Content } = await render(texto.entry);
const project = data.projeto ? projects.find((p) => p.slug === data.projeto) : undefined;
const series = project ? seriesFor(textos, project.slug) : [];
const { prev, next } = seriesNeighbors(series, slug);
const base = sectionPath(lang, 'texts');
const writtenIn = contentLangAttr(lang, texto.lang);
---

<BaseLayout
  lang={lang}
  title={`${data.titulo} · João Gabriel`}
  description={data.resumo}
  path={sectionPath(lang, 'texts', slug)}
  ogType="article"
>
  <article class="container article" style={project ? `--project-color: ${project.entry.data.cor}` : undefined}>
    <header class="head">
      {
        project && (
          <a class="back" href={sectionPath(lang, 'projects', project.slug)}>
            ← {t(lang, 'backTo')} {project.entry.data.titulo}
          </a>
        )
      }
      <h1 lang={writtenIn}>{data.titulo}</h1>
      <p class="lede" lang={writtenIn}>{data.resumo}</p>
      <p class="meta">
        <time datetime={data.data.toISOString().slice(0, 10)}>{formatDate(data.data, lang)}</time>
        {data.tags.map((tag) => <a class="chip" href={`${base}tag/${tag}/`}>#{tag}</a>)}
      </p>
      <FallbackNotice lang={lang} contentLang={texto.lang} />
    </header>

    <div class="prose" lang={writtenIn}>
      <Content />
    </div>

    {
      (prev || next) && project && (
        <nav class="series" aria-label={`${t(lang, 'partOf')} ${project.entry.data.titulo}`}>
          {prev ? (
            <a class="prev" href={sectionPath(lang, 'texts', prev.slug)}>
              <span>← {t(lang, 'previousInSeries')}</span>
              {prev.entry.data.titulo}
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="next" href={sectionPath(lang, 'texts', next.slug)}>
              <span>{t(lang, 'nextInSeries')} →</span>
              {next.entry.data.titulo}
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .article {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .head {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-7);
    max-width: 48rem;
    justify-items: start;
  }

  .back {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--project-color, var(--color-accent));
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: 800;
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .series {
    width: 100%;
    max-width: var(--width-prose);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .series a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--duration-fast) ease;
  }

  .series a:hover {
    transform: translateY(-2px);
  }

  .series span {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--project-color, var(--color-accent));
  }

  .next {
    grid-column: 2;
    text-align: right;
  }
</style>
