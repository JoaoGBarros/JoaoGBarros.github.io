---
import '../styles/global.css';

const site = Astro.site ?? new URL('https://joaogbarros.github.io');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>João Gabriel de Barros Rocha</title>
    <meta name="description" content="Software engineer · Engenheiro de software" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="pt" href={new URL('/pt/', site).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', site).href} />
    <script>
      import { chooseLang, sectionPath } from '../lib/i18n';

      let stored: string | null = null;
      try {
        stored = localStorage.getItem('lang');
      } catch {
        // Storage disabled: fall back to the browser language.
      }
      location.replace(sectionPath(chooseLang(stored, navigator.languages ?? [navigator.language]), 'home'));
    </script>
  </head>
  <body>
    <main class="choose">
      <p>João Gabriel de Barros Rocha</p>
      <p>
        <a href="/pt/" hreflang="pt" lang="pt-BR">Português</a>
        ·
        <a href="/en/" hreflang="en">English</a>
      </p>
    </main>
  </body>
</html>

<style>
  .choose {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: var(--space-3);
    text-align: center;
    font-family: var(--font-display);
  }
</style>
