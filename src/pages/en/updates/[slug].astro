---
import FeedPostView from '../../../views/FeedPostView.astro';
import { getAllSlugs } from '../../../lib/collections';

export async function getStaticPaths() {
  const slugs = await getAllSlugs('feed');
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<FeedPostView lang="en" slug={slug} />
