---
import type { Projeto } from '../lib/collections';
import { contentLangAttr, sectionPath, type Lang, type Localized } from '../lib/i18n';
import { t } from '../lib/ui-strings';

interface Props {
  lang: Lang;
  project: Localized<Projeto>;
  size: 'large' | 'small' | 'wide';
  textCount: number;
}

const { lang, project, size, textCount } = Astro.props;
const data = project.entry.data;
const href = sectionPath(lang, 'projects', project.slug);
const downloads = data.downloads.length;
const label = [data.periodo, ...data.stack.slice(0, 2)].join(' · ');
---

<article class:list={['card', size]} style={`--project-color: ${data.cor}`}>
  <div class="art dots" aria-hidden="true">
    {data.capa && <img src={data.capa.src} alt="" width={data.capa.width} height={data.capa.height} />}
    <span class="label pixel">{data.tipo === 'nao-codigo' ? `${data.periodo} · ${t(lang, 'nonCode')}` : label}</span>
  </div>
  <div class="body">
    <h3><a href={href}>{data.titulo}</a></h3>
    <p class="summary" lang={contentLangAttr(lang, project.lang)}>{data.resumo}</p>
    {
      (downloads > 0 || textCount > 0) && (
        <p class="facts">
          {downloads > 0 && <span>↓ {downloads} {t(lang, 'navDownloads').toLowerCase()}</span>}
          {textCount > 0 && <span>✎ {textCount} {t(lang, 'textsCount')}</span>}
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-4px) rotate(-0.4deg);
    box-shadow: var(--shadow-lift);
  }

  .art {
    position: relative;
    min-height: 7.5rem;
    border-radius: var(--radius-md);
    background-color: var(--project-color);
    background-image:
      radial-gradient(rgb(255 255 255 / 28%) 1.4px, transparent 1.6px),
      linear-gradient(135deg, var(--project-color), color-mix(in srgb, var(--project-color) 72%, #fff));
    background-size:
      12px 12px,
      100% 100%;
    overflow: hidden;
  }

  .art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .label {
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.7rem;
    color: #fff;
    font-size: 0.72rem;
    text-shadow: 0 1px 2px rgb(0 0 0 / 25%);
  }

  .body {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: 0 var(--space-2) var(--space-2);
  }

  h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* Whole card is clickable through the title link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .summary {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-soft);
  }

  /* No cartão grande, a arte cresce para ocupar a altura que o bento der. */
  .large {
    grid-template-rows: 1fr auto;
  }

  .large .art {
    min-height: 12rem;
  }

  .large h3 {
    font-size: var(--text-xl);
  }

  .large .summary {
    font-size: var(--text-base);
  }

  .wide {
    grid-template-columns: 11rem 1fr;
    grid-template-rows: auto;
    align-items: center;
  }

  .wide .art {
    min-height: 100%;
    height: 100%;
  }

  @media (max-width: 40rem) {
    .wide {
      grid-template-columns: 1fr;
    }

    .wide .art {
      min-height: 7.5rem;
    }
  }
</style>
